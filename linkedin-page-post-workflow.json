          "parameters": [
            {
              "name": "registerUploadRequest",
              "value": "{\n  \"recipes\": [\"urn:li:digitalmediaRecipe:feedshare-image\"],\n  \"owner\": \"urn:li:organization:{{$node[\"Get Organization ID\"].json[\"elements\"][0][\"id\"]}}\",\n  \"serviceRelationships\": [\n    {\n      \"relationshipType\": \"OWNER\",\n      \"identifier\": \"urn:li:userGeneratedContent\"\n    }\n  ]\n}"
            }
          ]
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "linkedInOAuth2Api",
        "options": {
          "bodyContentType": "json"
        }
      },

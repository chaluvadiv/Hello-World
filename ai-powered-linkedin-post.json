      "id": "1k2l3m4n-topic-rotation",
      "name": "Topic Rotation",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [340, 500]
    },
    {
      "parameters": {
        "jsCode": "// Rotate topics based on day of week and hour\nconst topics = JSON.parse($node[\"Topic Rotation\"].json[\"topics\"]);\nconst now = new Date();\nconst dayOfWeek = now.getDay(); // 0 = Sunday, 1 = Monday, etc.\nconst hour = now.getHours();\n\n// Create a seed based on day and hour for consistent rotation\nconst seed = dayOfWeek * 24 + hour;\nconst topicIndex = seed % topics.length;\nconst selectedTopic = topics[topicIndex];\n\n// Set tone based on time of day\nlet tone;\nif (hour < 12) {\n  tone = \"Motivational and energetic\";\n} else if (hour < 17) {\n  tone = \"Professional and informative\";\n} else {\n  tone = \"Reflective and thought-provoking\";\n}\n\n// Industry-specific hashtags based on topic\nlet hashtags;\nswitch(selectedTopic) {\n  case \"Artificial Intelligence\":\n    hashtags = \"#AI #ArtificialIntelligence #MachineLearning #Technology #Innovation\";\n    break;\n  case \"Machine Learning\":\n    hashtags = \"#MachineLearning #AI #DataScience #Algorithms #TechTrends\";\n    break;\n  case \"Data Science\":\n    hashtags = \"#DataScience #Analytics #BigData #DataDriven #Insights\";\n    break;\n  case \"Cloud Computing\":\n    hashtags = \"#CloudComputing #AWS #Azure #DigitalTransformation #Technology\";\n    break;\n  case \"Cybersecurity\":\n    hashtags = \"#Cybersecurity #InfoSec #Security #DataProtection #Technology\";\n    break;\n  case \"Remote Work\":\n    hashtags = \"#RemoteWork #WorkFromHome #DigitalWorkplace #Productivity #FutureOfWork\";\n    break;\n  case \"Leadership\":\n    hashtags = \"#Leadership #Management #TeamBuilding #ProfessionalDevelopment #Business\";\n    break;\n  default:\n    hashtags = \"#Technology #Innovation #Business #Professional #Growth\";\n}\n\nreturn {\n  topic: selectedTopic,\n  tone: tone,\n  hashtags: hashtags,\n  industry: \"Technology\",\n  organization_name: \"Your Company Name\"\n};"
      },

    {
      "parameters": {
        "url": "https://api.linkedin.com/v2/ugcPosts",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "author",
              "value": "urn:li:organization:{{$node[\"Get Organization ID\"].json[\"elements\"][0][\"id\"]}}"
            },
            {
              "name": "lifecycleState",
              "value": "PUBLISHED"
            },
            {
              "name": "specificContent",
              "value": "{\n  \"com.linkedin.ugc.ShareContent\": {\n    \"shareCommentary\": {\n      \"text\": \"{{$node[\"Prepare Text Content\"].json[\"post_text\"]}}\"\n    },\n    \"shareMediaCategory\": \"NONE\"\n  }\n}"
            },
            {
              "name": "visibility",
              "value": "{\n  \"com.linkedin.ugc.MemberNetworkVisibility\": \"PUBLIC\"\n}"
            }
          ]
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "linkedInOAuth2Api",
        "options": {
          "bodyContentType": "json",
          "headers": {
            "parameters": [
              {
                "name": "X-Restli-Protocol-Version",
                "value": "2.0.0"
              }
